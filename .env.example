# ── Alpaca (real-time data + paper trading) ──────────────────────────────
# Sign up free at https://alpaca.markets → Paper Trading → API Keys.
# Paper accounts come pre-loaded with $100,000 virtual cash.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex   # iex (free real-time) or sip ($99/mo full-market)

# ── Claude API (reasoning + daily summaries) ──────────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ── Optional: Financial Modeling Prep (fundamentals for picker) ───────────
FMP_API_KEY=

# ── Portfolio config ──────────────────────────────────────────────────────
STARTING_CAPITAL=100000
MAX_POSITION_PCT=10          # max 10% of equity per position
MAX_POSITIONS=12             # cap total concurrent positions
STOP_LOSS_PCT=5              # trail-stop trigger (% below entry)
TAKE_PROFIT_PCT=15           # take-profit trigger
VIX_DEFENSIVE=25             # above this → trim positions by 50%
VIX_RISK_OFF=32              # above this → close all longs

# Data dir (SQLite + logs). Defaults to ./data
DATA_DIR=./data
TIMEZONE=America/New_York
